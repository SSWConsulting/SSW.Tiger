# Option 1: OAuth Token (Recommended for Claude Pro/Max subscriptions)
# Best for: Production, high volume, predictable monthly costs
# How to get: Run "claude config get oauthToken" on your local machine
# Format: sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-YOUR-TOKEN-HERE

# Option 2: API Key (For pay-as-you-go usage)
# Best for: Testing, low volume, variable usage
# How to get: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Dashboard deployment (Azure Blob Storage)
# Storage account name for static website hosting
DASHBOARD_STORAGE_ACCOUNT=your_storage_account_name
# Custom domain for dashboard URLs (production: dashboards.sswtiger.com)
DASHBOARD_BASE_URL=dashboards.sswtiger.com

# Cosmos DB (meeting persistence)
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# ------------------------------------------------------------------------------
# Local Testing (Mock Mode)
# ------------------------------------------------------------------------------
# Use these variables to test locally without Graph API access

# Enable mock mode (bypasses Graph API, uses local VTT file)
# USE_MOCK_TRANSCRIPT=true
# MOCK_TRANSCRIPT_PATH=./dropzone/2026-01-22-sprint-review.vtt
# Mock meeting details (optional)
# MOCK_MEETING_SUBJECT=[TestProject] Sprint Review
# MOCK_MEETING_DATE=2026-01-22
# MEETING_FILTER_PATTERN=sprint

# ------------------------------------------------------------------------------
# Azure/Graph API Mode (Full Pipeline)
# ------------------------------------------------------------------------------
# These are passed by Azure Function when triggering Container App Job
# For local Graph API testing, set these manually

# Graph API credentials (from App Registration)
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-app-client-secret
GRAPH_TENANT_ID=your-tenant-id

# Meeting identifiers (passed by webhook)
GRAPH_USER_ID=meeting-organizer-user-id
GRAPH_MEETING_ID=online-meeting-id
GRAPH_TRANSCRIPT_ID=transcript-id

# ------------------------------------------------------------------------------
# Teams Notification (Optional)
# ------------------------------------------------------------------------------

# Logic App URL for sending Teams messages
# Get from Azure Portal after configuring Logic App HTTP trigger
LOGIC_APP_URL=https://prod-xx.australiaeast.logic.azure.com/workflows/...

# ------------------------------------------------------------------------------
# Raw Transcript Mirror (Optional)
# ------------------------------------------------------------------------------
# Tiger keeps only the generated dashboard + analysis. Enable this to also
# commit the raw transcript .vtt to a GitHub content repo (the source of truth).
# Leave MIRROR_REPO unset to disable.

# Target repo to commit the raw transcript into (owner/repo)
# MIRROR_REPO=tinacms/sprint-meetings
# Token with `contents:write` on MIRROR_REPO (fine-grained PAT recommended)
# MIRROR_GITHUB_TOKEN=github_pat_...
# Only mirror meetings whose subject/project matches this case-insensitive
# regex (default ".*" = all). Example: one team's transcripts only.
# MIRROR_PROJECT_FILTER=tinacloud
# Target branch (default: main)
# MIRROR_BRANCH=main
# Path prefix inside the repo (default: recordings/)
# MIRROR_PATH_PREFIX=recordings/

