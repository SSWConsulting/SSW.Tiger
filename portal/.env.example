PORTAL_ORIGIN=https://portal-test.sswtiger.com
OIDC_ISSUER=https://identity.ssw.com.au
OIDC_CLIENT_ID=ssw-tiger-portal-test
# Inject from Key Vault. Never commit real secrets.
OIDC_CLIENT_SECRET=
DASHBOARD_STORAGE_ACCOUNT=satigertestweb
DASHBOARD_CONTAINER=reports
PORTAL_SESSION_CONTAINER=portal-sessions
PORTAL_LEGACY_HOSTS=dashboards-test.sswtiger.com
# Bootstrap with verified IdentityServer subjects, not email addresses, Entra IDs or Microsoft ProviderKeys.
PORTAL_EMPLOYEE_SUBJECTS=
# Alternatively, configure an existing trusted employee claim below.
PORTAL_EMPLOYEE_CLAIM=
PORTAL_EMPLOYEE_VALUE=true
PORT=8080
